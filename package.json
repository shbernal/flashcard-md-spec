{
  "name": "@shbernal/flashcard-md-spec",
  "version": "0.0.1",
  "description": "A specification for writing flashcards in Markdown, with a conformance fixture corpus",
  "keywords": [
    "anki",
    "conformance",
    "fixtures",
    "flashcards",
    "markdown",
    "obsidian",
    "spaced-repetition",
    "specification"
  ],
  "license": "MIT",
  "author": "shbernal",
  "repository": {
    "type": "git",
    "url": "https://github.com/shbernal/flashcard-md-spec"
  },
  "files": [
    "SPEC.md",
    "fixtures",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./manifest.json": "./fixtures/manifest.json",
    "./fixtures/*": "./fixtures/*",
    "./examples/*": "./examples/*",
    "./SPEC.md": "./SPEC.md"
  },
  "scripts": {
    "check": "node scripts/check-corpus.mjs",
    "lint": "oxlint --deny-warnings scripts",
    "format": "oxfmt --check scripts package.json",
    "format:write": "oxfmt scripts package.json",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "devDependencies": {
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.21.0"
}
